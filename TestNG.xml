<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="RestAssuredTests">

    <test name="RestAssuredTests">

        <groups>
            <run>
                <include name="Regression"/>
                <include name="SmokeTest"/>
                <include name="DB_Related"/>
